kamil@prometheus:/opt$ cat grafana/docker-compose.yml
services:
  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped

    ports:
      - "3000:3000"

    volumes:
      - grafana-data:/var/lib/grafana

    networks:
      - monitoring

volumes:
  grafana-data:

networks:
  monitoring:
    external: true

kamil@prometheus:/opt$ cat prometheus/compose.yaml
services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: unless-stopped

    ports:
      - "9090:9090"

    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=30d"

    networks:
      - monitoring


    extra_hosts:
      - "host.docker.internal:host-gateway"

volumes:
  prometheus-data:

networks:
  monitoring:
    external: true

kamil@prometheus:/opt$ cat prometheus/prometheus.yml
